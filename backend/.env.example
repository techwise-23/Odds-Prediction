# Copy this file to .env and fill it in.
# Most of these (API key, Telegram, schedule, bookmakers, passcode...) can also be changed later in the admin console under
# Settings. A value saved there wins over this file until you reset it.

# Your API-Football key (https://dashboard.api-football.com). Leave empty to run with sample games.
API_FOOTBALL_KEY=

# Long random string used to sign login sessions. CHANGE THIS.
JWT_SECRET=replace-with-a-long-random-string

# Extra secret for the admin console login. Set this in production so a guessed admin phone number is not enough.
ADMIN_PASSCODE=

# Websites allowed to call this API (comma separated, no trailing slash): the public site and the admin console.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# 'lax' if the sites share a domain (app.x.com / admin.x.com / api.x.com). 'none' if they are on unrelated domains (needs HTTPS).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.x.com

# Phone numbers that get admin rights (can refresh predictions, add booking codes). Comma separated, e.g. 0241234567.
# If empty, the first account ever created becomes admin.
ADMIN_PHONES=

# Set to 1 when the site runs behind a proxy (Render, Railway, nginx) so rate limiting sees real visitor IPs.
# TRUST_PROXY=1

PORT=3000
TZ_NAME=Africa/Accra
# Daily prediction time (cron, in TZ_NAME). Default 6:00am.
PREDICT_CRON=0 6 * * *
# Settle finished games every hour at :15.
SETTLE_CRON=15 * * * *
# Bookmaker for odds on API-Football. 8 = Bet365.
BOOKMAKER_ID=8
# Where the SQLite database lives (use a persistent disk in production).
# DB_FILE=/var/data/app.db
# Where each bookmaker's "Open" button sends users. Check these are the right Ghana sites.
URL_SPORTYBET=https://www.sportybet.com/gh/
URL_MSPORT=https://www.msport.com/gh/
URL_FOOTBALLCOM=https://www.football.com/gh/
URL_BETWAY=https://www.betway.com.gh/

# Telegram alerts (optional). Create a bot with @BotFather and paste its token. Leave empty to turn alerts off.
TELEGRAM_BOT_TOKEN=
# Your site's public address, used for the "Open PawaOdds" link in messages (optional).
SITE_URL=

# --- Railway ---
# Variables to set in the Railway dashboard: JWT_SECRET, ADMIN_PHONES, ADMIN_PASSCODE, CORS_ORIGINS, COOKIE_SAMESITE, TRUST_PROXY=1, API_FOOTBALL_KEY, TELEGRAM_BOT_TOKEN, SITE_URL.
# NODE_ENV is set by the Dockerfile. The database goes on the Railway Volume automatically (RAILWAY_VOLUME_MOUNT_PATH).
